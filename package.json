{
  "name": "twot.staruml-plantuml-importer",
  "version": "2.3.0",
  "title": "PlantUML Importer",
  "description": "Import and auto-layout Use Case, Class, Sequence, Activity, State (unstable), ERD, Mindmap, and Requirement diagrams from PlantUML code into StarUML",
  "homepage": "https://github.com/TwotNguyenVN/staruml-plantuml-importer",
  "issues": "https://github.com/TwotNguyenVN/staruml-plantuml-importer/issues",
  "author": {
    "name": "Twot",
    "email": "twot@example.com",
    "url": "https://github.com/TwotNguyenVN"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwotNguyenVN/staruml-plantuml-importer.git"
  },
  "bugs": {
    "url": "https://github.com/TwotNguyenVN/staruml-plantuml-importer/issues"
  },
  "license": "MIT",
  "engines": {
    "staruml": ">=7.0.0"
  },
  "scripts": {
    "test": "node test/run_all_tests.js",
    "lint": "eslint .",
    "check:source": "node scripts/check-source.js",
    "check": "npm run lint && npm run check:source && npm test",
    "coverage": "c8 --all --include=main.js --include=manage.js --include=parsers/*.js --include=utils/*.js --reporter=text --reporter=lcov --check-coverage --statements=75 --lines=75 --branches=72 --functions=82 npm test"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^9.0.0"
  }
}
