@startuml
title Activity Diagram - UC2-LIB-01 - Lập Phiếu Mượn

skinparam shadowing false
skinparam activity {
  BackgroundColor White
  BorderColor Black
}

|Đọc Giả|
start
:Yêu cầu mượn sách;
:Xuất trình thẻ thư viện;
:Cung cấp thông tin sách cần mượn;

|Thủ Thư|
:Tiếp nhận yêu cầu mượn;
:Chọn chức năng Lập Phiếu Mượn;

|Hệ Thống|
:Kiểm tra thông tin đọc giả;

if (Tìm thấy đọc giả?) then (Có)

  :Kiểm tra thẻ thư viện;

  if (Thẻ còn hạn?) then (Có)

    :Kiểm tra lệ phí thẻ;

    if (Đã đóng lệ phí?) then (Có)

      :Kiểm tra sách quá hạn chưa trả;

      if (Còn sách quá hạn?) then (Không)

        :Kiểm tra thông tin sách cần mượn;

        if (Sách tồn tại?) then (Có)

          :Kiểm tra số lượng sách đọc giả đang mượn;

          if (Số lượng mượn không vượt quá 3 cuốn?) then (Có)

            :Kiểm tra số lượng sách hiện có;

            if (Sách còn số lượng?) then (Có)

              :Kiểm tra trùng đầu sách trong phiếu mượn;

              if (Có trùng đầu sách?) then (Không)

                |Thủ Thư|
                :Nhập thông tin phiếu mượn;
                :Nhập ngày mượn;
                :Nhập ngày trả dự kiến;
                :Xác nhận danh sách sách mượn;

                |Hệ Thống|
                :Tạo PhieuMuon;
                :Lưu PhieuMuon gồm maPhieuMuon, maDocGia, maNhanVien, ngayMuon, ngayTraDuKien, trangThai;

                if (Lưu phiếu mượn thành công?) then (Có)

                  :Tạo ChiTietPhieuMuon;
                  :Lưu ChiTietPhieuMuon gồm maPhieuMuon, maDauSach, soLuong, tinhTrangLucMuon, ghiChu;
                  :Cập nhật DauSach.soLuongHienCo;
                  :Cập nhật trạng thái phiếu mượn là Đang mượn;
                  :Thông báo lập phiếu mượn thành công;

                  |Thủ Thư|
                  :Giao sách và phiếu mượn cho đọc giả;

                  |Đọc Giả|
                  :Nhận sách và phiếu mượn;
                  stop

                else (Không)

                  :Thông báo lỗi không lưu được phiếu mượn;
                  :Không cập nhật số lượng sách;

                  |Thủ Thư|
                  :Thông báo lập phiếu mượn thất bại;

                  |Đọc Giả|
                  :Nhận thông báo lỗi;
                  stop

                endif

              else (Có)

                :Thông báo phiếu mượn bị trùng đầu sách;

                |Thủ Thư|
                :Yêu cầu chỉnh lại danh sách sách mượn;

                |Đọc Giả|
                :Cung cấp lại thông tin sách cần mượn;
                stop

              endif

            else (Không)

              :Thông báo sách không đủ số lượng;

              |Thủ Thư|
              :Từ chối lập phiếu mượn;

              |Đọc Giả|
              :Nhận thông báo sách không đủ để mượn;
              stop

            endif

          else (Không)

            :Thông báo đọc giả đã mượn đủ tối đa 3 cuốn;

            |Thủ Thư|
            :Từ chối lập phiếu mượn;

            |Đọc Giả|
            :Nhận thông báo không được mượn thêm;
            stop

          endif

        else (Không)

          :Thông báo không tìm thấy sách cần mượn;

          |Thủ Thư|
          :Từ chối lập phiếu mượn;

          |Đọc Giả|
          :Nhận thông báo sách không tồn tại;
          stop

        endif

      else (Có)

        :Thông báo đọc giả còn sách quá hạn chưa trả;

        |Thủ Thư|
        :Từ chối lập phiếu mượn;

        |Đọc Giả|
        :Nhận thông báo không được mượn thêm sách;
        stop

      endif

    else (Không)

      :Thông báo thẻ chưa đóng lệ phí;

      |Thủ Thư|
      :Yêu cầu đọc giả đóng lệ phí;

      |Đọc Giả|
      :Nhận yêu cầu đóng lệ phí;
      stop

    endif

  else (Không)

    :Thông báo thẻ thư viện hết hạn;

    |Thủ Thư|
    :Yêu cầu đọc giả gia hạn thẻ;

    |Đọc Giả|
    :Nhận yêu cầu gia hạn thẻ;
    stop

  endif

else (Không)

  :Thông báo không tìm thấy thông tin đọc giả;

  |Thủ Thư|
  :Từ chối lập phiếu mượn;

  |Đọc Giả|
  :Nhận thông báo lỗi thông tin đọc giả;
  stop

endif

@enduml