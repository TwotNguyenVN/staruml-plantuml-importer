@startuml
left to right direction

skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam shadowing false

actor "Admin" as Admin
actor "Staff" as Staff

rectangle "UC Cấp 1 — Khai thác AI và Knowledge Graph" {

  usecase "Khai thác AI và\nKnowledge Graph" as UC_AI_KG

  usecase "Đăng nhập" as UC_Login

  usecase "Yêu cầu AI giải thích\ncảnh báo tương tác thuốc" as UC_AIExplain

  usecase "Truy vấn Graph-RAG\nvề thuốc và hoạt chất" as UC_GraphRAG

  usecase "Khám phá quan hệ trong\nKnowledge Graph" as UC_ExploreGraph

  usecase "Xem nguồn bằng chứng\nvà dữ liệu liên quan" as UC_Evidence

  usecase "Xem lịch sử truy vấn\nvà giải thích AI" as UC_History

  usecase "Gửi phản hồi về\nkết quả AI" as UC_Feedback

  usecase "Đồng bộ dữ liệu vào\nKnowledge Graph" as UC_SyncGraph

  usecase "Kiểm tra trạng thái\nKnowledge Graph" as UC_GraphStatus
}

' ==================================================
' ACTOR VỚI USE CASE TRUNG TÂM
' ==================================================

Admin --> UC_AI_KG
Staff --> UC_AI_KG

' ==================================================
' INCLUDE
' ==================================================

UC_AI_KG ..> UC_Login : <<include>>

' ==================================================
' CÁC CHỨC NĂNG CON EXTEND USE CASE TRUNG TÂM
' ==================================================

UC_AIExplain ..> UC_AI_KG : <<extend>>

UC_GraphRAG ..> UC_AI_KG : <<extend>>

UC_ExploreGraph ..> UC_AI_KG : <<extend>>

UC_Evidence ..> UC_AI_KG : <<extend>>

UC_History ..> UC_AI_KG : <<extend>>

UC_Feedback ..> UC_AI_KG : <<extend>>

UC_SyncGraph ..> UC_AI_KG : <<extend>>

UC_GraphStatus ..> UC_AI_KG : <<extend>>

note right of UC_SyncGraph
  Chỉ Admin được phép
  thực hiện đồng bộ dữ liệu
  vào Knowledge Graph.
end note

note right of UC_GraphStatus
  Chỉ Admin được phép
  kiểm tra trạng thái đồng bộ
  và tính sẵn sàng của graph.
end note

@enduml
