@startuml
title ACTIVITY DIAGRAM - LẬP PHIẾU MƯỢN

skinparam shadowing false
skinparam activity {
    BackgroundColor #F5FFF9
    BorderColor #4F7F6F
    DiamondBackgroundColor #FFF2CC
    DiamondBorderColor #BF9000
}

|Độc giả|
start
:Yêu cầu mượn sách;

|Thủ thư|
:Yêu cầu thông tin độc giả;

|Độc giả|
:Cung cấp thông tin độc giả;

|Thủ thư|
:Tiếp nhận thông tin;

|Hệ thống|
:Kiểm tra thông tin độc giả;

if (Đủ điều kiện mượn?) then (Có)

    repeat
        |Thủ thư|
        :Yêu cầu thông tin sách;

        |Độc giả|
        :Cung cấp thông tin sách;

        |Thủ thư|
        :Chọn sách;

        |Hệ thống|
        :Kiểm tra sách;

        if (Còn sách?) then (Có)

            :Kiểm tra số lượng mượn;

            if (Tổng số sách vượt 3 cuốn?) then (Có)
                :Thông báo vượt 3 cuốn;
                :Hủy cuốn vừa chọn;
            else (Không)
                :Ghi nhận sách được chọn;
            endif

        else (Không)

            |Thủ thư|
            :Thông báo hết sách;

        endif

        ' Các nhánh phía trên được merge tại đây

    repeat while (Tiếp tục chọn sách?) is (Có)
    -> Không;

    |Hệ thống|
    if (Có sách được chọn?) then (Có)

        :Lập phiếu mượn;

        fork
            :Lưu phiếu mượn;
        fork again
            :Lưu chi tiết phiếu mượn;
        fork again
            :Cập nhật số lượng sách;
        end fork

        :In phiếu mượn;

        |Thủ thư|
        :Giao sách và phiếu mượn;

        |Độc giả|
        :Nhận sách và phiếu mượn;

    else (Không)

        |Thủ thư|
        :Thông báo chưa chọn được sách;

    endif

else (Không)

    |Thủ thư|
    :Thông báo không đủ điều kiện mượn;

endif

|Độc giả|
stop
@enduml