@startuml
left to right direction

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

skinparam rectangle {
  BorderColor #1F4E79
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #F8FBFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}

skinparam actor {
  BorderColor #1F4E79
  BackgroundColor #FFFFFF
}

title UC-00 — Use Case tổng quan cấp 0 LMS N18

' ==================================================
' ACTOR NGƯỜI DÙNG
' ==================================================

actor "Khách" as Guest

actor "Người dùng" as User
actor "Học viên" as Learner
actor "Giảng viên" as Instructor

actor "Admin" as Admin
actor "Kiểm duyệt viên" as Moderator
actor "Kế toán" as Accountant
actor "CSKH" as Support

' Học viên và Giảng viên là các actor chuyên biệt
' của actor Người dùng
User <|-- Learner
User <|-- Instructor

' ==================================================
' HỆ THỐNG NGOÀI
' ==================================================

actor "Đơn vị thanh toán\nvà chi trả" as PaymentPartner
actor "Email/OTP\nService" as EmailService
actor "CDN/DRM/Streaming\nService" as CDN

' ==================================================
' SYSTEM BOUNDARY
' ==================================================

rectangle "Hệ thống Quản lý Khóa học Trực tuyến LMS N18" {

  usecase "Quản lý tài khoản\nvà truy cập" as UC_P1

  usecase "Quản lý giảng viên" as UC_P2

  usecase "Quản lý khóa học" as UC_P3

  usecase "Kiểm duyệt nội dung" as UC_P4

  usecase "Quản lý học tập\nvà tiến độ" as UC_P5

  usecase "Quản lý đơn hàng,\nthanh toán, voucher\nvà hoàn tiền" as UC_P6

  usecase "Quản lý doanh thu,\ntài chính và chi trả" as UC_P7

  usecase "Quản lý chứng chỉ" as UC_P8

  usecase "Quản lý hỗ trợ\nvà vi phạm" as UC_P9

  usecase "Báo cáo và thống kê" as UC_P10

  usecase "Bảo mật video\nvà truy cập nội dung" as UC_P11
}

' ==================================================
' KHÁCH
' ==================================================

Guest -- UC_P1
Guest -- UC_P3
Guest -- UC_P8 : Xác minh chứng chỉ công khai

' ==================================================
' NGƯỜI DÙNG
' Các quan hệ này được Học viên và Giảng viên kế thừa
' ==================================================

User -- UC_P1
User -- UC_P9

' ==================================================
' HỌC VIÊN
' ==================================================

Learner -- UC_P3
Learner -- UC_P5
Learner -- UC_P6
Learner -- UC_P8
Learner -- UC_P11

' ==================================================
' GIẢNG VIÊN
' ==================================================

Instructor -- UC_P2
Instructor -- UC_P3
Instructor -- UC_P5
Instructor -- UC_P6
Instructor -- UC_P7
Instructor -- UC_P10

' ==================================================
' ADMIN
' ==================================================

Admin -- UC_P1
Admin -- UC_P2
Admin -- UC_P3
Admin -- UC_P4
Admin -- UC_P6
Admin -- UC_P7
Admin -- UC_P8
Admin -- UC_P9
Admin -- UC_P10
Admin -- UC_P11

' ==================================================
' KIỂM DUYỆT VIÊN
' ==================================================

Moderator -- UC_P2
Moderator -- UC_P4
Moderator -- UC_P8
Moderator -- UC_P9
Moderator -- UC_P10

' ==================================================
' KẾ TOÁN
' ==================================================

Accountant -- UC_P6
Accountant -- UC_P7
Accountant -- UC_P10

' ==================================================
' CSKH
' ==================================================

Support -- UC_P1
Support -- UC_P6
Support -- UC_P8
Support -- UC_P9

' ==================================================
' HỆ THỐNG NGOÀI
' Association không hướng
' ==================================================

UC_P6 -- PaymentPartner
UC_P7 -- PaymentPartner

UC_P1 -- EmailService
UC_P2 -- EmailService
UC_P9 -- EmailService

UC_P11 -- CDN

@enduml
