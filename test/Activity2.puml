@startuml
title Activity Diagram chi tiết - Độc giả mượn sách

scale 0.60
skinparam shadowing false
skinparam defaultFontSize 10
skinparam wrapWidth 160

skinparam activity {
    BackgroundColor #F8FBFF
    BorderColor #2F5597
    DiamondBackgroundColor #FFF2CC
    DiamondBorderColor #BF9000
    StartColor #548235
    EndColor #C00000
}

|Độc giả|
start
:Chọn các sách cần mượn;
:Xuất trình thẻ thư viện\nvà sách cho thủ thư;

|Thủ thư|
:Tiếp nhận yêu cầu mượn;
:Quét hoặc nhập mã thẻ;

|Hệ thống|
:Tra cứu thông tin độc giả\nvà thẻ thư viện;

if (Thẻ có tồn tại?) then (Có)

    if (Thẻ còn hạn?) then (Có)

        if (Đã đóng lệ phí?) then (Có)
            :Xác nhận thẻ hợp lệ;
        else (Không)
            :Thông báo chưa đóng lệ phí;
            :Từ chối yêu cầu mượn;
            stop
        endif

    else (Không)
        :Thông báo thẻ đã hết hạn;
        :Yêu cầu gia hạn thẻ;
        stop
    endif

else (Không)
    :Thông báo không tìm thấy thẻ;
    :Từ chối yêu cầu mượn;
    stop
endif

:Tra cứu các phiếu mượn\nchưa hoàn tất;

if (Có sách quá hạn?) then (Có)
    :Thông báo còn sách quá hạn;
    :Yêu cầu trả sách trước\nkhi mượn thêm;
    stop
else (Không)
    :Đếm số sách đang mượn;
endif

if (Đang mượn đủ 3 cuốn?) then (Có)
    :Thông báo đã đạt giới hạn\nmượn sách;
    stop
else (Không)
    :Cho phép kiểm tra sách mới;
endif

|Thủ thư|
:Quét mã từng cuốn sách;

repeat

    |Hệ thống|
    :Tra cứu cuốn sách\nvà đầu sách;

    if (Cuốn sách tồn tại?) then (Có)

        if (Sách sẵn sàng cho mượn?) then (Có)

            if (Trùng đầu sách\ntrong phiếu?) then (Có)
                :Đánh dấu sách không hợp lệ;
                :Lý do: trùng đầu sách;
            else (Không)

                :Tính tổng số sách\nsau khi thêm;

                if (Tổng số sách vượt 3?) then (Có)
                    :Đánh dấu sách không hợp lệ;
                    :Lý do: vượt giới hạn;
                else (Không)
                    :Thêm sách vào danh sách\nmượn hợp lệ;
                    :Ghi nhận tình trạng sách\ntrước khi cho mượn;
                endif

            endif

        else (Không)
            :Đánh dấu sách không hợp lệ;
            :Lý do: sách đã được mượn\nhoặc không thể cho mượn;
        endif

    else (Không)
        :Đánh dấu sách không hợp lệ;
        :Lý do: không tìm thấy sách;
    endif

    |Thủ thư|
    :Thông báo nếu sách\nkhông hợp lệ;
    :Quét sách tiếp theo;

repeat while (Còn sách cần quét?) is (Có)
-> Không;

|Hệ thống|
if (Có ít nhất một sách hợp lệ?) then (Có)

    :Hiển thị danh sách sách\nđược phép mượn;
    :Xác định ngày mượn;
    :Tính ngày phải trả;
    :Hiển thị thông tin\nphiếu mượn dự kiến;

else (Không)

    :Thông báo không có sách\nđủ điều kiện mượn;

    |Thủ thư|
    :Trả lại thẻ và sách;

    |Độc giả|
    :Nhận lại thẻ và sách;
    stop

endif

|Thủ thư|
:Kiểm tra danh sách sách\nvà ngày phải trả;

if (Xác nhận cho mượn?) then (Có)

    |Hệ thống|
    :Sinh mã phiếu mượn;
    :Lưu mã độc giả;
    :Lưu mã thủ thư;
    :Lưu ngày mượn\nvà ngày phải trả;

    :Lưu chi tiết từng sách mượn;
    :Cập nhật trạng thái sách\nthành "Đang mượn";
    :Cập nhật số lượng sách\nhiện có;

    :Thông báo lập phiếu\nmượn thành công;

    |Thủ thư|
    :In hoặc gửi phiếu mượn;
    :Giao sách và thẻ;
    :Nhắc độc giả ngày phải trả;

    |Độc giả|
    :Nhận sách, thẻ\nvà phiếu mượn;
    stop

else (Không)

    |Hệ thống|
    :Hủy yêu cầu mượn;
    :Không lưu phiếu mượn;

    |Thủ thư|
    :Trả lại thẻ và sách;

    |Độc giả|
    :Nhận lại thẻ và sách;
    stop

endif

@enduml