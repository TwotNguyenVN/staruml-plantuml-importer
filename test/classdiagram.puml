@startuml
title Class Diagram - Hệ thống quản lý thư viện

skinparam classAttributeIconSize 0
skinparam shadowing false

class "Độc giả" as DocGia {
  - maDocGia: String
  - hoTen: String
  - ngaySinh: Date
  - gioiTinh: String
  - soDienThoai: String
  - email: String
  - diaChi: String
  - trangThai: String
  + dangKy()
  + capNhatThongTin()
  + yeuCauMuonSach()
  + traSach()
}

class "Thủ thư" as ThuThu {
  - maThuThu: String
  - hoTen: String
  - soDienThoai: String
  - email: String
  + tiepNhanYeuCauMuon()
  + lapPhieuMuon()
  + lapPhieuTra()
  + quanLySach()
  + quanLyDocGia()
}

class "Tài khoản" as TaiKhoan {
  - maTaiKhoan: String
  - tenDangNhap: String
  - matKhau: String
  - vaiTro: String
  - trangThai: String
  + dangNhap()
  + dangXuat()
  + doiMatKhau()
  + khoaTaiKhoan()
}

class "Sách" as Sach {
  - maSach: String
  - tenSach: String
  - namXuatBan: int
  - soLuong: int
  - soLuongCon: int
  - viTriKe: String
  - trangThai: String
  + capNhatThongTin()
  + capNhatSoLuong()
  + kiemTraTinhTrang()
}

class "Thể loại" as TheLoai {
  - maTheLoai: String
  - tenTheLoai: String
  - moTa: String
  + themTheLoai()
  + suaTheLoai()
}

class "Tác giả" as TacGia {
  - maTacGia: String
  - tenTacGia: String
  - quocTich: String
  + themTacGia()
  + suaTacGia()
}

class "Nhà xuất bản" as NhaXuatBan {
  - maNXB: String
  - tenNXB: String
  - diaChi: String
  - soDienThoai: String
  + themNXB()
  + suaNXB()
}

class "Phiếu mượn" as PhieuMuon {
  - maPhieuMuon: String
  - ngayMuon: Date
  - ngayHenTra: Date
  - trangThai: String
  + taoPhieuMuon()
  + capNhatTrangThai()
  + inPhieuMuon()
}

class "Chi tiết phiếu mượn" as ChiTietPhieuMuon {
  - maChiTietMuon: String
  - soLuong: int
  - tinhTrangSachMuon: String
  + themChiTiet()
  + capNhatChiTiet()
}

class "Phiếu trả" as PhieuTra {
  - maPhieuTra: String
  - ngayTra: Date
  - ghiChu: String
  + taoPhieuTra()
  + capNhatPhieuTra()
}

class "Chi tiết phiếu trả" as ChiTietPhieuTra {
  - maChiTietTra: String
  - tinhTrangSachTra: String
  - soNgayTre: int
  + kiemTraSachTra()
  + tinhSoNgayTre()
}

class "Phiếu phạt" as PhieuPhat {
  - maPhieuPhat: String
  - lyDoPhat: String
  - soTienPhat: double
  - trangThaiThanhToan: String
  + tinhTienPhat()
  + capNhatThanhToan()
}

class "Đặt trước sách" as DatTruocSach {
  - maDatTruoc: String
  - ngayDat: Date
  - trangThai: String
  + taoYeuCauDatTruoc()
  + huyDatTruoc()
}

' Quan hệ tài khoản
DocGia "1" -- "1" TaiKhoan : sử dụng
ThuThu "1" -- "1" TaiKhoan : sử dụng

' Quan hệ sách
TheLoai "1" -- "0..*" Sach : phân loại
TacGia "1" -- "0..*" Sach : viết
NhaXuatBan "1" -- "0..*" Sach : xuất bản

' Quan hệ mượn sách
DocGia "1" -- "0..*" PhieuMuon : có
ThuThu "1" -- "0..*" PhieuMuon : lập
PhieuMuon "1" -- "1..*" ChiTietPhieuMuon : gồm
ChiTietPhieuMuon "1" -- "1" Sach : mượn

' Quan hệ trả sách
PhieuMuon "1" -- "0..1" PhieuTra : được trả bằng
ThuThu "1" -- "0..*" PhieuTra : xử lý
PhieuTra "1" -- "1..*" ChiTietPhieuTra : gồm
ChiTietPhieuTra "1" -- "1" Sach : trả

' Quan hệ phạt
DocGia "1" -- "0..*" PhieuPhat : có
PhieuTra "1" -- "0..1" PhieuPhat : phát sinh

' Quan hệ đặt trước
DocGia "1" -- "0..*" DatTruocSach : đặt trước
DatTruocSach "1" -- "1" Sach : cho sách

@enduml