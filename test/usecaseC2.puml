@startuml
left to right direction

skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam shadowing false

actor "Admin" as Admin
actor "Staff" as Staff

rectangle "UC Cấp 2 — AI giải thích cảnh báo tương tác thuốc" {

  usecase "Yêu cầu AI giải thích\ncảnh báo tương tác thuốc" as UC_Explain

  usecase "Chọn cảnh báo\ncần giải thích" as UC_SelectAlert
  usecase "Kiểm tra dữ liệu\ncảnh báo" as UC_ValidateAlert
  usecase "Xây dựng ngữ cảnh\ngiải thích" as UC_BuildContext
  usecase "Kiểm tra đầu vào\nbằng Guardrail" as UC_InputGuardrail
  usecase "Sinh nội dung\ngiải thích" as UC_Generate
  usecase "Kiểm tra đầu ra\nbằng Guardrail" as UC_OutputGuardrail
  usecase "Gắn nguồn bằng chứng\nvà disclaimer" as UC_AttachEvidence
  usecase "Ghi AI Audit Log" as UC_Audit
  usecase "Hiển thị kết quả\nở trạng thái nháp" as UC_DisplayDraft

  usecase "Chặn yêu cầu\nkhông an toàn" as UC_BlockInput
  usecase "Chặn kết quả\nkhông an toàn" as UC_BlockOutput
  usecase "Sử dụng MockAI hoặc\nprovider dự phòng" as UC_Fallback
  usecase "Thông báo không đủ\ndữ liệu giải thích" as UC_NoContext
}

Admin --> UC_Explain
Staff --> UC_Explain

UC_Explain ..> UC_SelectAlert : <<include>>
UC_Explain ..> UC_ValidateAlert : <<include>>
UC_Explain ..> UC_BuildContext : <<include>>
UC_Explain ..> UC_InputGuardrail : <<include>>
UC_Explain ..> UC_Generate : <<include>>
UC_Explain ..> UC_OutputGuardrail : <<include>>
UC_Explain ..> UC_AttachEvidence : <<include>>
UC_Explain ..> UC_Audit : <<include>>
UC_Explain ..> UC_DisplayDraft : <<include>>

UC_BlockInput ..> UC_Explain : <<extend>>\n[input vi phạm Guardrail]
UC_BlockOutput ..> UC_Explain : <<extend>>\n[output vi phạm Guardrail]
UC_Fallback ..> UC_Explain : <<extend>>\n[AI Provider chính không khả dụng]
UC_NoContext ..> UC_Explain : <<extend>>\n[thiếu dữ liệu cảnh báo hoặc graph context]

@enduml
