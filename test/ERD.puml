@startuml
title ERD tổng thể — PharmaAssist AI Intelligence

left to right direction
hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
}

' =========================================================
' 1. NGƯỜI DÙNG VÀ PHÂN QUYỀN
' =========================================================

package "Người dùng và phân quyền" {

  entity "NGƯỜI_DÙNG\nusers" as users {
    * id : UUID <<PK>>
    --
    * auth_user_id : UUID <<UQ>>
    * email : VARCHAR <<UQ>>
    * full_name : VARCHAR
    phone : VARCHAR
    * status : VARCHAR
    * created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "VAI_TRÒ\nroles" as roles {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    description : TEXT
  }

  entity "QUYỀN\npermissions" as permissions {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    * module : VARCHAR
    description : TEXT
  }

  entity "NGƯỜI_DÙNG_VAI_TRÒ\nuser_roles" as user_roles {
    * user_id : UUID <<PK, FK>>
    * role_id : UUID <<PK, FK>>
    --
    assigned_by : UUID <<FK>>
    * assigned_at : TIMESTAMP
  }

  entity "VAI_TRÒ_QUYỀN\nrole_permissions" as role_permissions {
    * role_id : UUID <<PK, FK>>
    * permission_id : UUID <<PK, FK>>
  }
}

' =========================================================
' 2. DANH MỤC THUỐC
' =========================================================

package "Danh mục thuốc" {

  entity "NHÀ_SẢN_XUẤT\nmanufacturers" as manufacturers {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    country : VARCHAR
    address : TEXT
    * status : VARCHAR
  }

  entity "ĐƠN_VỊ_THUỐC\nmedicine_units" as medicine_units {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    symbol : VARCHAR
  }

  entity "DANH_MỤC_THUỐC\ncategories" as categories {
    * id : UUID <<PK>>
    --
    parent_id : UUID <<FK>>
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    description : TEXT
  }

  entity "THUỐC\nmedicines" as medicines {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    registration_number : VARCHAR <<UQ>>
    manufacturer_id : UUID <<FK>>
    unit_id : UUID <<FK>>
    description : TEXT
    sale_price : DECIMAL
    prescription_required : BOOLEAN
    * status : VARCHAR
    * created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "HOẠT_CHẤT\nactive_ingredients" as active_ingredients {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    description : TEXT
  }

  entity "THUỐC_HOẠT_CHẤT\nmedicine_ingredients" as medicine_ingredients {
    * medicine_id : UUID <<PK, FK>>
    * ingredient_id : UUID <<PK, FK>>
    --
    strength : VARCHAR
    is_primary : BOOLEAN
  }

  entity "THUỐC_DANH_MỤC\nmedicine_categories" as medicine_categories {
    * medicine_id : UUID <<PK, FK>>
    * category_id : UUID <<PK, FK>>
  }
}

' =========================================================
' 3. NHÀ CUNG CẤP VÀ KHO
' =========================================================

package "Nhà cung cấp và kho" {

  entity "NHÀ_CUNG_CẤP\nsuppliers" as suppliers {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * name : VARCHAR
    phone : VARCHAR
    email : VARCHAR
    address : TEXT
    * status : VARCHAR
  }

  entity "PHIẾU_NHẬP_KHO\nstock_imports" as stock_imports {
    * id : UUID <<PK>>
    --
    * import_code : VARCHAR <<UQ>>
    * supplier_id : UUID <<FK>>
    * created_by : UUID <<FK>>
    * status : VARCHAR
    imported_at : TIMESTAMP
    total_cost : DECIMAL
    note : TEXT
    * created_at : TIMESTAMP
  }

  entity "CHI_TIẾT_PHIẾU_NHẬP\nstock_import_items" as stock_import_items {
    * id : UUID <<PK>>
    --
    * stock_import_id : UUID <<FK>>
    * medicine_id : UUID <<FK>>
    inventory_batch_id : UUID <<FK>>
    * batch_number : VARCHAR
    * expiry_date : DATE
    * quantity : INTEGER
    * unit_cost : DECIMAL
    * subtotal : DECIMAL
  }

  entity "TỒN_KHO\ninventories" as inventories {
    * id : UUID <<PK>>
    --
    * medicine_id : UUID <<FK, UQ>>
    * total_quantity : INTEGER
    * min_stock : INTEGER
    * updated_at : TIMESTAMP
  }

  entity "LÔ_THUỐC\ninventory_batches" as inventory_batches {
    * id : UUID <<PK>>
    --
    * inventory_id : UUID <<FK>>
    * batch_number : VARCHAR
    * expiry_date : DATE
    * quantity : INTEGER
    * unit_cost : DECIMAL
    * status : VARCHAR
    * created_at : TIMESTAMP
  }

  entity "BIẾN_ĐỘNG_KHO\nstock_movements" as stock_movements {
    * id : UUID <<PK>>
    --
    * inventory_id : UUID <<FK>>
    inventory_batch_id : UUID <<FK>>
    * performed_by : UUID <<FK>>
    * movement_type : VARCHAR
    * quantity : INTEGER
    reference_type : VARCHAR
    reference_id : UUID
    note : TEXT
    * created_at : TIMESTAMP
  }
}

' =========================================================
' 4. BÁN HÀNG, THANH TOÁN, HÓA ĐƠN
' =========================================================

package "Bán hàng và thanh toán" {

  entity "KHÁCH_HÀNG\ncustomers" as customers {
    * id : UUID <<PK>>
    --
    * code : VARCHAR <<UQ>>
    * full_name : VARCHAR
    phone : VARCHAR
    email : VARCHAR
    address : TEXT
    * created_at : TIMESTAMP
  }

  entity "ĐƠN_HÀNG\norders" as orders {
    * id : UUID <<PK>>
    --
    * order_code : VARCHAR <<UQ>>
    customer_id : UUID <<FK>>
    * staff_id : UUID <<FK>>
    * status : VARCHAR
    * subtotal : DECIMAL
    * discount_amount : DECIMAL
    * total_amount : DECIMAL
    consultation_note : TEXT
    * created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "CHI_TIẾT_ĐƠN_HÀNG\norder_items" as order_items {
    * id : UUID <<PK>>
    --
    * order_id : UUID <<FK>>
    * medicine_id : UUID <<FK>>
    * quantity : INTEGER
    * unit_price : DECIMAL
    * subtotal : DECIMAL
  }

  entity "THANH_TOÁN\npayments" as payments {
    * id : UUID <<PK>>
    --
    * order_id : UUID <<FK>>
    * method : VARCHAR
    * amount : DECIMAL
    * status : VARCHAR
    transaction_reference : VARCHAR
    paid_at : TIMESTAMP
    * created_at : TIMESTAMP
  }

  entity "HÓA_ĐƠN\ninvoices" as invoices {
    * id : UUID <<PK>>
    --
    * order_id : UUID <<FK, UQ>>
    * payment_id : UUID <<FK, UQ>>
    * invoice_number : VARCHAR <<UQ>>
    * total_amount : DECIMAL
    * status : VARCHAR
    * issued_at : TIMESTAMP
  }
}

' =========================================================
' 5. TƯƠNG TÁC THUỐC
' =========================================================

package "Tương tác thuốc" {

  entity "QUY_TẮC_TƯƠNG_TÁC\ndrug_interactions" as drug_interactions {
    * id : UUID <<PK>>
    --
    * medicine_a_id : UUID <<FK>>
    * medicine_b_id : UUID <<FK>>
    * severity : VARCHAR
    * description : TEXT
    * recommendation : TEXT
    evidence_source : VARCHAR
    * status : VARCHAR
    * created_at : TIMESTAMP
  }

  entity "LẦN_KIỂM_TRA_TƯƠNG_TÁC\ninteraction_checks" as interaction_checks {
    * id : UUID <<PK>>
    --
    order_id : UUID <<FK>>
    * requested_by : UUID <<FK>>
    * status : VARCHAR
    * checked_at : TIMESTAMP
  }

  entity "CHI_TIẾT_KIỂM_TRA\ninteraction_check_items" as interaction_check_items {
    * check_id : UUID <<PK, FK>>
    * medicine_id : UUID <<PK, FK>>
  }

  entity "CẢNH_BÁO_TƯƠNG_TÁC\ninteraction_alerts" as interaction_alerts {
    * id : UUID <<PK>>
    --
    * check_id : UUID <<FK>>
    * interaction_id : UUID <<FK>>
    * severity : VARCHAR
    * status : VARCHAR
    * message : TEXT
    recommendation : TEXT
    acknowledged_at : TIMESTAMP
    resolved_at : TIMESTAMP
  }

  entity "GHI_CHÚ_TƯ_VẤN\nconsultation_notes" as consultation_notes {
    * id : UUID <<PK>>
    --
    * alert_id : UUID <<FK>>
    * author_id : UUID <<FK>>
    confirmed_by : UUID <<FK>>
    * content : TEXT
    * source : VARCHAR
    confirmed_at : TIMESTAMP
    * created_at : TIMESTAMP
  }
}

' =========================================================
' 6. AI, KNOWLEDGE GRAPH VÀ KIỂM TOÁN
' =========================================================

package "AI, Knowledge Graph và kiểm toán" {

  entity "GIẢI_THÍCH_AI\nai_explanations" as ai_explanations {
    * id : UUID <<PK>>
    --
    * alert_id : UUID <<FK>>
    * requested_by : UUID <<FK>>
    * provider : VARCHAR
    * prompt_type : VARCHAR
    * content : TEXT
    * guardrail_status : VARCHAR
    * requires_confirmation : BOOLEAN
    confirmed_by : UUID <<FK>>
    confirmed_at : TIMESTAMP
    * created_at : TIMESTAMP
  }

  entity "NHẬT_KÝ_AI\nai_audit_logs" as ai_audit_logs {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    order_id : UUID <<FK>>
    alert_id : UUID <<FK>>
    explanation_id : UUID <<FK>>
    * provider : VARCHAR
    * prompt_type : VARCHAR
    * input_guardrail_status : VARCHAR
    * output_guardrail_status : VARCHAR
    * request_status : VARCHAR
    * created_at : TIMESTAMP
  }

  entity "TRUY_VẤN_GRAPH\ngraph_queries" as graph_queries {
    * id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
    question : TEXT
    response : TEXT
    graph_context : JSONB
    * status : VARCHAR
    * created_at : TIMESTAMP
  }

  entity "ĐỒNG_BỘ_GRAPH\ngraph_sync_jobs" as graph_sync_jobs {
    * id : UUID <<PK>>
    --
    * started_by : UUID <<FK>>
    * scope : VARCHAR
    * status : VARCHAR
    total_records : INTEGER
    success_records : INTEGER
    failed_records : INTEGER
    error_message : TEXT
    started_at : TIMESTAMP
    completed_at : TIMESTAMP
  }

  entity "NHẬT_KÝ_HỆ_THỐNG\nsystem_audit_logs" as system_audit_logs {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    * action : VARCHAR
    * entity_type : VARCHAR
    entity_id : UUID
    old_value : JSONB
    new_value : JSONB
    ip_address : VARCHAR
    * created_at : TIMESTAMP
  }
}

' =========================================================
' QUAN HỆ: NGƯỜI DÙNG VÀ PHÂN QUYỀN
' =========================================================

users ||--o{ user_roles : "được gán"
roles ||--o{ user_roles : "bao gồm"

roles ||--o{ role_permissions : "được cấp"
permissions ||--o{ role_permissions : "thuộc"

users ||--o{ user_roles : "gán bởi"

' =========================================================
' QUAN HỆ: DANH MỤC THUỐC
' =========================================================

manufacturers ||--o{ medicines : "sản xuất"
medicine_units ||--o{ medicines : "đơn vị"

categories |o--o{ categories : "danh mục cha"

medicines ||--o{ medicine_ingredients : "chứa"
active_ingredients ||--o{ medicine_ingredients : "tham gia"

medicines ||--o{ medicine_categories : "được phân loại"
categories ||--o{ medicine_categories : "bao gồm"

' =========================================================
' QUAN HỆ: KHO
' =========================================================

suppliers ||--o{ stock_imports : "cung cấp"
users ||--o{ stock_imports : "tạo"

stock_imports ||--|{ stock_import_items : "gồm"
medicines ||--o{ stock_import_items : "được nhập"

medicines ||--|| inventories : "có tồn kho"
inventories ||--o{ inventory_batches : "gồm các lô"

inventory_batches |o--o{ stock_import_items : "được tạo từ"

inventories ||--o{ stock_movements : "phát sinh"
inventory_batches |o--o{ stock_movements : "liên quan"
users ||--o{ stock_movements : "thực hiện"

' =========================================================
' QUAN HỆ: BÁN HÀNG
' =========================================================

customers |o--o{ orders : "đặt/mua"
users ||--o{ orders : "xử lý"

orders ||--|{ order_items : "gồm"
medicines ||--o{ order_items : "được bán"

orders ||--o{ payments : "có lần thanh toán"
orders ||--o| invoices : "có hóa đơn"
payments ||--o| invoices : "tạo hóa đơn"

' =========================================================
' QUAN HỆ: TƯƠNG TÁC THUỐC
' =========================================================

medicines ||--o{ drug_interactions : "thuốc A"
medicines ||--o{ drug_interactions : "thuốc B"

orders |o--o{ interaction_checks : "được kiểm tra"
users ||--o{ interaction_checks : "yêu cầu"

interaction_checks ||--|{ interaction_check_items : "gồm thuốc"
medicines ||--o{ interaction_check_items : "được kiểm tra"

interaction_checks ||--o{ interaction_alerts : "sinh cảnh báo"
drug_interactions ||--o{ interaction_alerts : "áp dụng quy tắc"

interaction_alerts ||--o{ consultation_notes : "có ghi chú"
users ||--o{ consultation_notes : "tạo/xác nhận"

' =========================================================
' QUAN HỆ: AI, GRAPH, AUDIT
' =========================================================

interaction_alerts ||--o{ ai_explanations : "được giải thích"
users ||--o{ ai_explanations : "yêu cầu/xác nhận"

users ||--o{ ai_audit_logs : "thực hiện"
orders |o--o{ ai_audit_logs : "liên quan"
interaction_alerts |o--o{ ai_audit_logs : "liên quan"
ai_explanations |o--o| ai_audit_logs : "được ghi log"

users ||--o{ graph_queries : "thực hiện"
users ||--o{ graph_sync_jobs : "khởi chạy"

users |o--o{ system_audit_logs : "thực hiện"

' =========================================================
' GHI CHÚ RÀNG BUỘC
' =========================================================

note right of invoices
  Ràng buộc:
  - Một đơn hàng có tối đa một hóa đơn.
  - Hóa đơn chỉ được tạo khi
    thanh toán thành công.
end note

note right of drug_interactions
  UNIQUE đề xuất:
  medicine_a_id + medicine_b_id

  Chuẩn hóa thứ tự hai thuốc
  để tránh lưu trùng A-B và B-A.
end note

note right of inventory_batches
  UNIQUE đề xuất:
  inventory_id + batch_number

  quantity >= 0
  expiry_date phải hợp lệ.
end note

note bottom of ai_audit_logs
  Mỗi lần gọi AI phải tạo Audit Log.
  Không lưu dữ liệu nhạy cảm
  không cần thiết.
end note

note bottom of graph_sync_jobs
  Node và relationship thực tế
  được lưu trong Neo4j.

  PostgreSQL chỉ lưu trạng thái đồng bộ,
  lịch sử truy vấn và nhật ký.
end note

@enduml